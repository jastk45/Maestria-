        "name": "consultar_sql",
        "args": "{\"consulta\": \"WITH mensual AS (\\n  SELECT strftime('%Y-%m', fecha) AS mes,\\n         SUM(cantidad * precio_unitario * (1 - descuento)) AS importe\\n  FROM ventas\\n  WHERE fecha >= '2025-01-01' AND fecha <= '2025-12-31'\\n  GROUP BY mes\\n)\\nSELECT mes, importe,\\n       ROUND((importe - LAG(importe) OVER (ORDER BY mes)) / LAG(importe) OVER (ORDER BY mes) * 100, 2) AS crecimiento_pct\\nFROM mensual\\nORDER BY mes\"}"
