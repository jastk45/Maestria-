        "name": "consultar_sql",
        "args": "{\"consulta\": \"WITH t AS (\\n  SELECT cantidad * precio_unitario * (1.0 - descuento) AS importe\\n  FROM ventas\\n  WHERE fecha >= '2025-01-01' AND fecha < '2026-01-01'\\n), o AS (\\n  SELECT importe,\\n         ROW_NUMBER() OVER (ORDER BY importe) AS rn,\\n         COUNT(*) OVER () AS n\\n  FROM t\\n)\\nSELECT importe AS p90, n AS n_ventas\\nFROM o\\nWHERE rn = CAST(0.9 * n AS INTEGER) + (0.9 * n > CAST(0.9 * n AS INTEGER))\"}"
