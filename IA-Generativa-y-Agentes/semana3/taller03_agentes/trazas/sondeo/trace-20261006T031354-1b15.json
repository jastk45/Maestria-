      "action": {
        "name": "consultar_sql",
        "args": "{\"consulta\": \"SELECT region, AVG(importe) AS mediana, COUNT(*) AS n_ventas FROM (SELECT c.region AS region, v.cantidad * v.precio_unitario * (1 - v.descuento) AS importe, ROW_NUMBER() OVER (PARTITION BY c.region ORDER BY v.cantidad * v.precio_unitario * (1 - v.descuento)) AS rn, COUNT(*) OVER (PARTITION BY c.region) AS cnt FROM ventas v JOIN clientes c ON v.cliente_id = c.cliente_id WHERE v.fecha >= '2025-01-01' AND v.fecha <= '2025-12-31') WHERE rn = cnt / 2 + 1 OR (rn = cnt / 2 AND cnt % 2 = 0) GROUP BY region ORDER BY mediana\"}"
      },
