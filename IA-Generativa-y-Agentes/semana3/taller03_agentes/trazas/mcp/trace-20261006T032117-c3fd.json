      "action": {
        "name": "consultar_sql",
        "args": "{\"consulta\": \"WITH v AS (\\n  SELECT p.producto_id, p.nombre,\\n         v.cantidad * v.precio_unitario * (1 - v.descuento) AS importe,\\n         ROW_NUMBER() OVER (PARTITION BY p.producto_id ORDER BY v.cantidad * v.precio_unitario * (1 - v.descuento)) AS rn,\\n         COUNT(*) OVER (PARTITION BY p.producto_id) AS n\\n  FROM ventas v\\n  JOIN productos p ON p.producto_id = v.producto_id\\n  WHERE v.fecha >= '2025-01-01' AND v.fecha < '2026-01-01'\\n)\\nSELECT nombre, ROUND(AVG(importe), 2) AS mediana_importe, COUNT(*) AS n_ventas\\nFROM v\\nWHERE rn IN ((n + 1) / 2, (n + 2) / 2)\\nGROUP BY producto_id, nombre\\nORDER BY mediana_importe DESC\"}"
      },
