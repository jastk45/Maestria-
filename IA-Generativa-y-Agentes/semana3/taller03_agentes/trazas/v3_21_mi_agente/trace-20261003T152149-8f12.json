        "name": "consultar_sql",
        "args": "{\"consulta\": \"WITH m AS (SELECT strftime('%Y-%m', fecha) AS mes, SUM(cantidad * precio_unitario * (1 - descuento)) AS importe FROM ventas WHERE fecha >= '2025-01-01' AND fecha <= '2025-12-31' GROUP BY mes), g AS (SELECT mes, importe, LAG(importe) OVER (ORDER BY mes) AS importe_anterior, ROUND(100.0 * (importe - LAG(importe) OVER (ORDER BY mes)) / LAG(importe) OVER (ORDER BY mes), 2) AS crecimiento_pct FROM m) SELECT mes, importe, importe_anterior, crecimiento_pct FROM g WHERE importe_anterior IS NOT NULL ORDER BY crecimiento_pct DESC LIMIT 3\"}"
