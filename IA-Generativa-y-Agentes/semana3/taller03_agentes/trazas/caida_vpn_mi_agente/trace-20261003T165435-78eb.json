        "name": "consultar_sql",
        "args": "{\"consulta\": \"SELECT c.region, SUM(v.cantidad * v.precio_unitario * (1 - v.descuento)) AS importe_total, COUNT(DISTINCT v.cliente_id) AS clientes, SUM(v.cantidad * v.precio_unitario * (1 - v.descuento)) / COUNT(DISTINCT v.cliente_id) AS importe_medio_por_cliente FROM ventas v JOIN clientes c ON v.cliente_id = c.cliente_id WHERE v.fecha >= '2025-01-01' AND v.fecha <= '2025-12-31' GROUP BY c.region ORDER BY importe_medio_por_cliente DESC\"}"
