        "args": "{\"consulta\": \"WITH m AS (SELECT substr(fecha,1,7) AS mes, SUM(cantidad * precio_unitario * (1 - descuento)) AS importe FROM ventas WHERE fecha >= '2025-01-01' AND fecha <= '2025-12-31' GROUP BY mes) SELECT mes, importe, ROUND(100.0 * (importe - LAG(importe) OVER (ORDER BY mes)) / LAG(importe) OVER (ORDER BY mes), 2) AS crecimiento_pct FROM m ORDER BY mes\"}"
