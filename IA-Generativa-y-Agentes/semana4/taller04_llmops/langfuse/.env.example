# Copia este archivo a .env (no se versiona) y rellénalo. ./levantar_langfuse.sh escribe solo el
# primer bloque; el segundo es el modelo, igual que en el Lab 03.

# --- Langfuse (Settings → API Keys de tu proyecto, o lo que escribe levantar_langfuse.sh)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
#   o https://cloud.langfuse.com con Langfuse Cloud

# --- El modelo: cualquier servidor compatible con OpenAI
# H200 de la USFQ (con la VPN GlobalProtect):
OPENAI_BASE_URL=http://172.28.230.10:12555/v1
OPENAI_API_KEY=
# Sin VPN, con Ollama en tu máquina:
#   OPENAI_BASE_URL=http://localhost:11434/v1
#   OPENAI_API_KEY=ollama
# Opcional: el id del modelo. Si se deja vacío, demo.py le pregunta al servidor cuál sirve.
MODELO=
